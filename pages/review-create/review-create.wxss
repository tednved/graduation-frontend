/* pages/review-create/review-create.wxss */
.review {
  padding-bottom: 60rpx;
}

.review__block {
  background-color: #ffffff;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.review__target {
  font-size: 30rpx;
  font-weight: 600;
}

.review__hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #fa9d3b;
}

.review__section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.review__stars {
  display: flex;
  align-items: center;
}

.review__star {
  font-size: 60rpx;
  color: #e0e0e0;
  padding-right: 16rpx;
}

.review__star--on {
  color: #fa9d3b;
}

.review__rating-value {
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #666666;
}

.review__textarea {
  width: 100%;
  height: 220rpx;
  font-size: 28rpx;
  background-color: #f7f7f7;
  border-radius: 12rpx;
  padding: 20rpx;
}

.review__counter {
  margin-top: 12rpx;
  text-align: right;
  font-size: 24rpx;
  color: #b0b0b0;
}

.review__submit {
  padding: 0 24rpx;
}
