/* pages/item-detail/item-detail.wxss */
.detail {
  padding-bottom: 60rpx;
}

.detail__notice {
  padding: 16rpx 24rpx;
  background-color: #fff5e6;
  color: #fa9d3b;
  font-size: 26rpx;
}

.detail__gallery {
  position: relative;
  background-color: #ffffff;
}

.detail__swiper {
  width: 100%;
  height: 600rpx;
}

.detail__image {
  width: 100%;
  height: 600rpx;
  background-color: #f5f6f8;
}

.detail__counter {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  background-color: rgba(0, 0, 0, 0.45);
  color: #ffffff;
  font-size: 22rpx;
}

.detail__placeholder {
  width: 100%;
  height: 600rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b0b0b0;
}

.detail__block {
  background-color: #ffffff;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.detail__price {
  display: flex;
  align-items: baseline;
}

.detail__price-now {
  font-size: 44rpx;
  font-weight: 600;
  color: #fa5151;
}

.detail__price-old {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #b0b0b0;
  text-decoration: line-through;
}

.detail__title {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 600;
}

.detail__tags {
  margin-top: 16rpx;
}

.detail__tags .item-card__tag {
  margin-left: 12rpx;
}

.detail__stats {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999999;
}

.detail__stats-sep {
  padding: 0 10rpx;
}

.detail__section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.detail__seller {
  font-size: 28rpx;
  color: #576b95;
}

.detail__description {
  font-size: 28rpx;
  color: #333333;
  white-space: pre-wrap;
  word-break: break-all;
}

.detail__actions {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  flex-wrap: wrap;
}

.detail__favorite {
  padding: 12rpx 32rpx;
  margin-right: 20rpx;
  border-radius: 32rpx;
  background-color: #ffffff;
  color: #666666;
  font-size: 28rpx;
}

.detail__favorite--on {
  color: #fa5151;
}

.detail__action-btn {
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
}

.detail__action-btn--primary {
  background-color: #07c160;
}
