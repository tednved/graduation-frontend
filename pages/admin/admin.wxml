<!--pages/admin/admin.wxml-->
<view class="admin" wx:if="{{roleChecked && isAdmin}}">
  <view class="admin__tabs">
    <view
      class="admin__tab {{tab === item.key ? 'admin__tab--on' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-tab="{{item.key}}"
      bindtap="onSwitchTab"
    >{{item.label}}</view>
  </view>

  <!-- 筛选区：五个区域各一组，同一时刻只显示当前区域的那组 -->
  <block wx:if="{{tab === 'certifications'}}">
    <view class="admin__filter">
      <picker
        class="admin__picker"
        mode="selector"
        range="{{certStatusOptions}}"
        range-key="label"
        value="{{certStatusIndex}}"
        bindchange="onCertStatusChange"
      >
        <view class="admin__picker-value">{{certStatusOptions[certStatusIndex].label}} ▾</view>
      </picker>
    </view>
  </block>

  <block wx:elif="{{tab === 'users'}}">
    <view class="admin__filter">
      <input
        class="admin__input"
        value="{{userKeyword}}"
        placeholder="昵称 / 手机号"
        confirm-type="search"
        bindinput="onUserKeywordInput"
        bindconfirm="onUserKeywordConfirm"
      />
      <view class="admin__search" bindtap="onUserKeywordConfirm">查询</view>
      <picker
        class="admin__picker"
        mode="selector"
        range="{{userStatusOptions}}"
        range-key="label"
        value="{{userStatusIndex}}"
        bindchange="onUserStatusChange"
      >
        <view class="admin__picker-value">{{userStatusOptions[userStatusIndex].label}} ▾</view>
      </picker>
      <picker
        class="admin__picker"
        mode="selector"
        range="{{userCertOptions}}"
        range-key="label"
        value="{{userCertIndex}}"
        bindchange="onUserCertChange"
      >
        <view class="admin__picker-value">{{userCertOptions[userCertIndex].label}} ▾</view>
      </picker>
    </view>
  </block>

  <block wx:elif="{{tab === 'items'}}">
    <view class="admin__filter">
      <input
        class="admin__input"
        value="{{itemKeyword}}"
        placeholder="商品标题"
        confirm-type="search"
        bindinput="onItemKeywordInput"
        bindconfirm="onItemKeywordConfirm"
      />
      <view class="admin__search" bindtap="onItemKeywordConfirm">查询</view>
      <picker
        class="admin__picker"
        mode="selector"
        range="{{itemStatusOptions}}"
        range-key="label"
        value="{{itemStatusIndex}}"
        bindchange="onItemStatusChange"
      >
        <view class="admin__picker-value">{{itemStatusOptions[itemStatusIndex].label}} ▾</view>
      </picker>
    </view>
  </block>

  <block wx:elif="{{tab === 'orders'}}">
    <view class="admin__filter">
      <input
        class="admin__input"
        value="{{orderKeyword}}"
        placeholder="订单号 / 商品标题"
        confirm-type="search"
        bindinput="onOrderKeywordInput"
        bindconfirm="onOrderKeywordConfirm"
      />
      <view class="admin__search" bindtap="onOrderKeywordConfirm">查询</view>
      <picker
        class="admin__picker"
        mode="selector"
        range="{{orderStatusOptions}}"
        range-key="label"
        value="{{orderStatusIndex}}"
        bindchange="onOrderStatusChange"
      >
        <view class="admin__picker-value">{{orderStatusOptions[orderStatusIndex].label}} ▾</view>
      </picker>
    </view>
  </block>

  <block wx:else>
    <view class="admin__filter">
      <picker
        class="admin__picker"
        mode="selector"
        range="{{auditActionOptions}}"
        range-key="label"
        value="{{auditActionIndex}}"
        bindchange="onAuditActionChange"
      >
        <view class="admin__picker-value">{{auditActionOptions[auditActionIndex].label}} ▾</view>
      </picker>
    </view>
  </block>

  <view class="list-state" wx:if="{{loading}}">
    <view class="list-state__desc">加载中…</view>
  </view>

  <view class="list-state" wx:elif="{{failed}}">
    <view class="list-state__title">加载失败</view>
    <view class="list-state__desc">请检查网络后重试</view>
    <button class="list-state__btn" size="mini" bindtap="onRetry">重试</button>
  </view>

  <view class="list-state" wx:elif="{{list.length === 0}}">
    <view class="list-state__title">{{emptyTitle}}</view>
    <view class="list-state__desc">{{emptyDesc}}</view>
  </view>

  <block wx:else>
    <!-- 认证审核 -->
    <block wx:if="{{tab === 'certifications'}}">
      <view class="admin-card" wx:for="{{list}}" wx:key="id">
        <view class="admin-card__head">
          <text class="admin-card__title">{{item.realNameMasked}} · {{item.typeLabel}}</text>
          <text class="item-status item-status--{{item.statusTone}}">{{item.statusLabel}}</text>
        </view>
        <view class="admin-card__meta">学号 {{item.studentNoMasked}}</view>
        <view class="admin-card__meta">校区 {{item.campusName}} · 提交 {{item.createdAt}}</view>
        <view class="admin-card__meta" wx:if="{{item.rejectReason}}">驳回原因：{{item.rejectReason}}</view>
        <view class="admin-card__meta" wx:if="{{item.reviewedAt}}">审核时间 {{item.reviewedAt}}</view>
        <view class="admin-card__ops" wx:if="{{item.pending}}">
          <button class="admin-btn admin-btn--primary" size="mini" disabled="{{acting}}" data-id="{{item.id}}" bindtap="onApproveCertification">通过</button>
          <button class="admin-btn admin-btn--danger" size="mini" disabled="{{acting}}" data-id="{{item.id}}" bindtap="onRejectCertification">驳回</button>
        </view>
      </view>
    </block>

    <!-- 用户 -->
    <block wx:elif="{{tab === 'users'}}">
      <view class="admin-card" wx:for="{{list}}" wx:key="id">
        <view class="admin-card__head" data-id="{{item.id}}" bindtap="onTapUser">
          <text class="admin-card__title">{{item.nickname}}</text>
          <text class="item-status item-status--{{item.statusTone}}">{{item.statusLabel}}</text>
        </view>
        <view class="admin-card__meta">ID {{item.id}} · {{item.roleLabel}} · {{item.phone}}</view>
        <view class="admin-card__meta">校区 {{item.campusName}} · 认证 {{item.certLabel}}</view>
        <view class="admin-card__meta">信用 {{item.averageRating}}（{{item.reviewCount}} 次评价）· 注册 {{item.createdDate}}</view>
        <view class="admin-card__ops">
          <button
            class="admin-btn {{item.enabled ? 'admin-btn--danger' : 'admin-btn--primary'}}"
            size="mini"
            disabled="{{acting}}"
            data-id="{{item.id}}"
            data-status="{{item.status}}"
            data-nickname="{{item.nickname}}"
            bindtap="onToggleUser"
          >{{item.enabled ? '禁用' : '恢复'}}</button>
        </view>
      </view>
    </block>

    <!-- 商品 -->
    <block wx:elif="{{tab === 'items'}}">
      <view class="admin-card" wx:for="{{list}}" wx:key="id">
        <view class="admin-card__head" data-id="{{item.id}}" bindtap="onTapItem">
          <text class="admin-card__title">{{item.title}}</text>
          <text class="item-status item-status--{{item.statusTone}}">{{item.statusLabel}}</text>
        </view>
        <view class="admin-card__meta">{{item.priceText}} · {{item.categoryName}} · 卖家 {{item.sellerName}}</view>
        <view class="admin-card__meta">收藏 {{item.favoriteCount}} · 浏览 {{item.viewCount}} · 发布 {{item.createdDate}}</view>
        <view class="admin-card__meta" wx:if="{{item.adminLock}}">已被管理员锁定</view>
        <view class="admin-card__meta" wx:if="{{item.offShelfReason}}">下架原因：{{item.offShelfReason}}</view>
        <view class="admin-card__ops" wx:if="{{item.offShelfable}}">
          <button class="admin-btn admin-btn--danger" size="mini" disabled="{{acting}}" data-id="{{item.id}}" data-title="{{item.title}}" bindtap="onOffShelfItem">强制下架</button>
        </view>
      </view>
    </block>

    <!-- 全站订单：只读，点击进入管理员专属详情 -->
    <block wx:elif="{{tab === 'orders'}}">
      <view class="admin-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onTapOrder">
        <view class="admin-card__head">
          <text class="admin-card__title">{{item.itemTitle}}</text>
          <text class="item-status item-status--{{item.statusTone}}">{{item.statusLabel}}</text>
        </view>
        <view class="admin-card__meta">订单 {{item.orderNo}} · {{item.amountText}}</view>
        <view class="admin-card__meta">买家 {{item.buyerName}} · 卖家 {{item.sellerName}}</view>
        <view class="admin-card__meta">{{item.createdAt}}</view>
      </view>
    </block>

    <!-- 审计 -->
    <block wx:else>
      <view class="admin-card" wx:for="{{list}}" wx:key="id">
        <view class="admin-card__head">
          <text class="admin-card__title">{{item.actionLabel}}</text>
          <text class="admin-card__muted">{{item.createdAt}}</text>
        </view>
        <view class="admin-card__meta">操作者 {{item.operatorName}}（ID {{item.operatorId}}）</view>
        <view class="admin-card__meta">目标 {{item.targetTypeLabel}} #{{item.targetId}}</view>
        <view class="admin-card__meta" wx:if="{{item.detailText}}">{{item.detailText}}</view>
        <view class="admin-card__meta admin-card__meta--dim" wx:if="{{item.requestId}}">请求 {{item.requestId}}</view>
      </view>
    </block>

    <view class="list-more" wx:if="{{loadingMore}}">加载中…</view>
    <view class="list-more" wx:elif="{{!hasNext}}">没有更多了</view>
  </block>
</view>
