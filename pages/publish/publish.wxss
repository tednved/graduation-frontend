/* pages/publish/publish.wxss */
.publish {
  padding: 24rpx 24rpx 60rpx;
}

.publish__loading,
.publish__blocked {
  margin-top: 120rpx;
  text-align: center;
  color: #999999;
}

.publish__blocked-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f1f1f;
}

.publish__blocked-desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #8a8a8a;
}

.publish__blocked-btn {
  margin-top: 40rpx;
}

.publish__section {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.publish__field {
  margin-bottom: 28rpx;
}

.publish__field:last-child {
  margin-bottom: 0;
}

.publish__field--row {
  display: flex;
  justify-content: space-between;
}

.publish__field-half {
  width: 48%;
}

.publish__label {
  font-size: 28rpx;
  color: #1f1f1f;
  margin-bottom: 12rpx;
}

.publish__hint {
  font-size: 24rpx;
  color: #999999;
}

.publish__hint--block {
  display: block;
  margin-top: 12rpx;
}

.publish__input,
.publish__textarea,
.publish__picker {
  width: 100%;
  background-color: #f5f6f8;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
}

.publish__textarea {
  height: 200rpx;
}

.publish__picker {
  color: #1f1f1f;
}

.publish__images {
  display: flex;
  flex-wrap: wrap;
}

.publish__image-item,
.publish__image-add {
  width: 200rpx;
  height: 200rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.publish__image {
  width: 100%;
  height: 100%;
  background-color: #f5f6f8;
}

.publish__image-tools {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: space-around;
  background-color: rgba(0, 0, 0, 0.45);
}

.publish__image-btn {
  color: #ffffff;
  font-size: 30rpx;
  padding: 6rpx 16rpx;
}

.publish__image-btn--danger {
  color: #ffd7d7;
}

.publish__image-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #f5f6f8;
  border: 2rpx dashed #d0d0d0;
}

.publish__image-add-icon {
  font-size: 56rpx;
  color: #b0b0b0;
  line-height: 1;
}

.publish__image-add-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999999;
}

.publish__actions {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}

.publish__btn {
  width: 48%;
  font-size: 30rpx;
}

.publish__btn--primary {
  background-color: #07c160;
}

.publish__draft {
  margin-top: 28rpx;
  display: flex;
  justify-content: center;
}

.publish__draft-link {
  font-size: 26rpx;
  color: #576b95;
  padding: 0 30rpx;
}
