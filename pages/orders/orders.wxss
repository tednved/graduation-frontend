/* pages/orders/orders.wxss */
.orders {
  padding-bottom: 40rpx;
}

.orders__side {
  display: flex;
  background-color: #ffffff;
}

.orders__side-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #666666;
}

.orders__side-item--on {
  color: #07c160;
  font-weight: 600;
  border-bottom: 4rpx solid #07c160;
}

.orders__filter {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #f0f0f0;
}

.orders__picker-value {
  font-size: 26rpx;
  color: #576b95;
}

.orders__list {
  padding: 20rpx 24rpx 0;
}

.order-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.order-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-card__no {
  font-size: 24rpx;
  color: #999999;
}

.order-card__body {
  display: flex;
  margin-top: 16rpx;
}

.order-card__cover {
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  background-color: #f5f6f8;
}

.order-card__info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.order-card__title {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.order-card__amount {
  font-size: 30rpx;
  font-weight: 600;
  color: #fa5151;
}

.order-card__meta {
  font-size: 24rpx;
  color: #999999;
}

.order-card__foot {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #b0b0b0;
}
